# Zenith Local Configuration
HOST=127.0.0.1
PORT=5000
FLASK_SECRET_KEY=change-me
FLASK_ENV=development
APP_PASSWORD=change-me-on-first-setup

# Database & storage (local defaults — on Render use /var/data/* via render.yaml)
DATABASE_PATH=database/invoice_cheque.db
UPLOAD_FOLDER=storage/invoices
INBOUND_QUEUE_DIR=data/inbound_queue
CHROMA_PERSIST_DIR=database/chroma
MAX_UPLOAD_MB=10

# WhatsApp — Meta Cloud API (production)
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=zenith-meta-verify
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
WEBHOOK_PUBLIC_URL=http://127.0.0.1:5000
# 6-digit WhatsApp two-step verification PIN (phone Cloud API /register only — not used by the web app)
META_PHONE_PIN=


# Public legal pages (Meta App Review) — shown on /privacy, /terms, /data-deletion
LEGAL_CONTACT_EMAIL=

# Optional: comma-separated allow-list if DB whitelist is empty
WHATSAPP_ALLOWED_NUMBERS=

# Local dev without Meta credentials
USE_WHATSAPP_MOCK=false
MOCK_IMAGE_PATH=

# Optional Twilio provider (WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional Node.js bridge (dev only — not required for Meta webhook)
WHATSAPP_BRIDGE_SECRET=change-me
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
ZENITH_INGEST_URL=http://127.0.0.1:5000/api/invoices/ingest

# Gemini — invoice document check + OCR (Agent 1)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# OpenAI — Bundling Assistant + analyst (optional)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_ANALYST_MODEL=gpt-5.6-sol
USE_FAKE_AI=false

# LangChain tool-calling Bundling Assistant
USE_BUNDLING_TOOL_AGENT=true

# Agent 3: Gemini tool-calling strategist (bundling.py + guardrails)
USE_STRATEGIST_TOOL_AGENT=true

# Cash-flow alerts
MERCHANT_WHATSAPP_PHONE=
ENABLE_CASH_ALERTS=false
CASH_ALERT_DAYS_AHEAD=3

# Defaults
DEFAULT_CREDIT_PERIOD_DAYS=30
MIN_CASH_BUFFER_LKR=500000
CASUAL_DAILY_LIMIT_LKR=1000000