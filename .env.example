# Flask
FLASK_SECRET_KEY=change-me
FLASK_ENV=development

# Gemini — Agent 1 invoice vision only
# Create key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash

# OpenAI — Bundling Assistant (tool-calling) + analyst reports
# Allowed models only: gpt-5.6-luna | gpt-5.6-sol
# Create key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_ANALYST_MODEL=gpt-5.6-sol

# Quota protection — set true while designing UI (zero API calls for chat)
USE_FAKE_AI=false

# LangChain tool-calling Bundling Assistant (false = legacy JSON proposed_actions)
USE_BUNDLING_TOOL_AGENT=true

# Database & storage
DATABASE_PATH=database/invoice_cheque.db
UPLOAD_FOLDER=storage/invoices
MAX_UPLOAD_MB=10

# App login (single user — set before running scripts/init_db.py)
APP_PASSWORD=change-me-on-first-setup

# WhatsApp channel — Meta Cloud API (default) or twilio
# Meta setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=zenith-meta-verify
# Optional: App Secret for X-Hub-Signature-256 validation
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Optional legacy Twilio provider (set WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

WHATSAPP_ALLOWED_NUMBERS=
USE_WHATSAPP_MOCK=true
# Optional local image for mock runs (skips cloud media download)
MOCK_IMAGE_PATH=
MERCHANT_WHATSAPP_PHONE=
ENABLE_CASH_ALERTS=false
CASH_ALERT_DAYS_AHEAD=3

# Defaults
DEFAULT_CREDIT_PERIOD_DAYS=30
MIN_CASH_BUFFER_LKR=500000
CASUAL_DAILY_LIMIT_LKR=1000000
